{
  "manifest_version": 3,
  "name": "HopeScroll - Your Brainrot Champion",
  "version": "0.1.0",
  "description": "Your Brainrot Champion.",
  "permissions": ["storage", "tabs"],
  "host_permissions": ["*://*.youtube.com/*", "https://www.googleapis.com/*"],
  "icons": {
    "16":  "icons/icon16.png",
    "32":  "icons/icon32.png",
    "48":  "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": ["*://*.youtube.com/shorts/*"],
      "js": ["storage.js", "content-script.js"],
      "run_at": "document_idle"
    }
  ],
  "action": {
    "default_popup": "popup/popup.html",
    "default_icon": {
      "16":  "icons/icon16.png",
      "32":  "icons/icon32.png",
      "48":  "icons/icon48.png",
      "128": "icons/icon128.png"
    },
    "default_title": "HopeScroll"
  },
  "web_accessible_resources": [
    {
      "resources": ["intention/*", "journal/*", "lemon/*"],
      "matches": ["*://*.youtube.com/*"]
    }
  ]
}
